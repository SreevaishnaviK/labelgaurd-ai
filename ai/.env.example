SERVICE_PORT=8002

# AI-assisted extraction provider: none | mock | openai.
# "none" runs deterministic extraction only and requires no API key.
AI_PROVIDER=none

# Optional JSON script for the mock provider (offline AI-assisted demos).
# Example: [{"field_name":"mrp","status":"detected","value":{"amount":72,
#          "currency":"INR"},"confidence":88,"evidence_block_ids":["block_003"]}]
MOCK_AI_FIELDS=

# Deterministic results at/above this confidence are final in auto mode.
AI_MIN_DETERMINISTIC_CONFIDENCE=85

# OpenAI settings — used only when AI_PROVIDER=openai. Never commit real keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
