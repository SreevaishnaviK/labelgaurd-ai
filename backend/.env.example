# --- Database ---
# Example: postgresql+psycopg://labelguard:password@localhost:5432/labelguard
DATABASE_URL=

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# --- Internal service URLs (Docker service names) ---
CV_SERVICE_URL=http://computer-vision:8001
AI_SERVICE_URL=http://ai:8002
LEGAL_ENGINE_URL=http://legal-engine:8003

# --- Uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=20
CV_TIMEOUT_SECONDS=60
